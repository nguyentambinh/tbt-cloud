APP_NAME="Distributed Cloud Control API"
WEB_DIR=
DATABASE_URL=postgresql+psycopg://cloud:replace-local-password@localhost:5432/cloud
JWT_SECRET=replace-with-at-least-32-random-bytes
FERNET_KEY=replace-with-a-generated-fernet-key
JWT_EXPIRE_MINUTES=60
JWT_ISSUER=distributed-cloud
SSH_PORT_START=22000
SSH_PORT_END=22999
GATEWAY_HOST=gateway.example.test
SCHEDULER_STRATEGY=best-fit
PROXMOX_TIMEOUT=10
PROXMOX_TASK_TIMEOUT=180
WORKERS_ENABLED=false
CORS_ORIGINS=["http://localhost:5173"]
VIRTUAL_TOPUP_ENABLED=false
# true | false | đường dẫn tệp CA (pve-root-ca.pem) của các node
PROXMOX_VERIFY_SSL=true
# Bỏ dòng này nếu không dùng node-agent; token khi đặt phải có ít nhất 32 byte
# AGENT_TOKEN=replace-with-a-random-agent-token-at-least-32-bytes

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=
# Để trống dùng mặc định 10000 và 5000000 VND
PAYOS_MIN_AMOUNT=
PAYOS_MAX_AMOUNT=
# Để trống dùng mặc định false, smtp.gmail.com, 587 và 30 phút
NOTIFY_ENABLED=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD_FILE=
NOTIFY_TO=
NOTIFY_DEDUP_MINUTES=

BACKUP_DIR=/opt/cloud/backups
BACKUP_KEEP=10
BACKUP_TIMEOUT=120
