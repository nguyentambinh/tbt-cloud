#!/bin/bash
# Nguyễn Tâm Bình - 2324801030003
set -euo pipefail
DS=/var/lib/tbt/vm-dang-chay.txt
mkdir -p /var/lib/tbt
qm list | awk 'NR>1 && $3=="running" {print $1}' > "$DS"
echo "VM dang chay se bat lai khi ve Debian: $(tr '\n' ' ' < "$DS")"
grub-reboot "Windows 11 (Boot Manager)"
echo "Lan khoi dong ke tiep vao Windows. Khoi dong lai sau 5 giay (Ctrl+C de huy)..."
sleep 5
systemctl reboot
